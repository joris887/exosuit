{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "includeGitInstructions": false,
  "attribution": {
    "commit": "Co-Authored-By: Claude <noreply@anthropic.com>"
  },
  "plansDirectory": "docs/plans",
  "outputStyle": ".claude/output-styles/framework.md",
  "spinnerVerbs": {
    "mode": "append",
    "verbs": [
      "Discovering",
      "Planning",
      "Building",
      "Testing",
      "Reviewing",
      "Shipping",
      "Analyzing",
      "Refactoring",
      "Investigating"
    ]
  },
  "spinnerTipsOverride": {
    "excludeDefault": false,
    "tips": [
      "Use /story-cycle for structured story delivery",
      "Run /doctor to check framework health",
      "Use /research for evidence-backed decisions",
      "TDD first — write tests before implementation",
      "Use /handoff before ending a session",
      "Run /sprint-end to ship completed work",
      "Use /bootstrap to set up a new project",
      "Never claim done without test evidence",
      "Use /debug-session for structured root-cause analysis",
      "Use /continue to resume from last session"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "cd \"$(git rev-parse --show-toplevel 2>/dev/null || echo .)\" && bash .claude/hooks/status-line.sh"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel 2>/dev/null || echo .)\" && sh .claude/hooks/session-start.sh",
            "once": true,
            "statusMessage": "Checking project environment..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel 2>/dev/null || echo .)\" && sh .claude/hooks/pre-tool-use.sh",
            "statusMessage": "Safety check..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel 2>/dev/null || echo .)\" && sh .claude/hooks/worktree-bash-fix.sh"
          }
        ],
        "apply_to_subagents": true
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel 2>/dev/null || echo .)\" && sh .claude/hooks/post-tool-use.sh",
            "statusMessage": "Logging activity..."
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel 2>/dev/null || echo .)\" && bash .claude/hooks/post-edit-format.sh \"$FILE_PATH\"",
            "statusMessage": "Auto-formatting..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel 2>/dev/null || echo .)\" && sh .claude/hooks/stop.sh",
            "statusMessage": "Quality gate..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel 2>/dev/null || echo .)\" && sh .claude/hooks/user-prompt.sh",
            "statusMessage": "Analyzing request..."
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel 2>/dev/null || echo .)\" && sh .claude/hooks/worktree.sh WorktreeCreate",
            "statusMessage": "Setting up worktree..."
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel 2>/dev/null || echo .)\" && sh .claude/hooks/worktree.sh WorktreeRemove",
            "statusMessage": "Cleaning up worktree..."
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel 2>/dev/null || echo .)\" && sh .claude/hooks/subagent-stop.sh"
          }
        ]
      }
    ]
  }
}
