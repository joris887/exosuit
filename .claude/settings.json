{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "statusLine": {
    "type": "command",
    "command": "bash __PROJECT_ROOT__/.claude/hooks/status-line.sh"
  },
  "attribution": "Co-Authored-By: Claude <noreply@anthropic.com>",
  "plansDirectory": "docs/plans",
  "includeGitInstructions": false,
  "hooks": {
    "SessionStart": [
      {
        "once": true,
        "hooks": [
          {
            "type": "command",
            "command": "sh __PROJECT_ROOT__/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh __PROJECT_ROOT__/.claude/hooks/post-tool-use.sh"
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash __PROJECT_ROOT__/.claude/hooks/post-edit-format.sh \"$FILE_PATH\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh __PROJECT_ROOT__/.claude/hooks/pre-tool-use.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh __PROJECT_ROOT__/.claude/hooks/worktree-bash-fix.sh"
          }
        ],
        "apply_to_subagents": true
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh __PROJECT_ROOT__/.claude/hooks/stop.sh"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh __PROJECT_ROOT__/.claude/hooks/pre-compact.sh"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh __PROJECT_ROOT__/.claude/hooks/post-compact.sh"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh __PROJECT_ROOT__/.claude/hooks/stop-failure.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh __PROJECT_ROOT__/.claude/hooks/user-prompt.sh"
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh __PROJECT_ROOT__/.claude/hooks/worktree.sh WorktreeCreate"
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh __PROJECT_ROOT__/.claude/hooks/worktree.sh WorktreeRemove"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh __PROJECT_ROOT__/.claude/hooks/subagent-stop.sh"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh __PROJECT_ROOT__/.claude/hooks/session-end.sh"
          }
        ]
      }
    ],
    "Setup": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh __PROJECT_ROOT__/.claude/hooks/setup.sh"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh __PROJECT_ROOT__/.claude/hooks/post-tool-failure.sh"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh __PROJECT_ROOT__/.claude/hooks/permission-request.sh"
          }
        ]
      }
    ],
    "ConfigChange": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh __PROJECT_ROOT__/.claude/hooks/config-change.sh"
          }
        ]
      }
    ]
  }
}
