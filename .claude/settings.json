{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "statusLine": {
    "type": "command",
    "command": "bash __PROJECT_ROOT__/.claude/hooks/status-line.sh"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__PYTHON_PATH__ __PROJECT_ROOT__/.claude/hooks/engine.py SessionStart"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "__PYTHON_PATH__ __PROJECT_ROOT__/.claude/hooks/engine.py PostToolUse"
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash __PROJECT_ROOT__/.claude/hooks/post-edit-format.sh \"$FILE_PATH\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "__PYTHON_PATH__ __PROJECT_ROOT__/.claude/hooks/engine.py PreToolUse"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh __PROJECT_ROOT__/.claude/hooks/worktree-bash-fix.sh"
          }
        ],
        "apply_to_subagents": true
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__PYTHON_PATH__ __PROJECT_ROOT__/.claude/hooks/engine.py Stop"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__PYTHON_PATH__ __PROJECT_ROOT__/.claude/hooks/engine.py UserPromptSubmit"
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__PYTHON_PATH__ __PROJECT_ROOT__/.claude/hooks/engine.py WorktreeCreate"
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__PYTHON_PATH__ __PROJECT_ROOT__/.claude/hooks/engine.py WorktreeRemove"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__PYTHON_PATH__ __PROJECT_ROOT__/.claude/hooks/engine.py SubagentStop"
          }
        ]
      }
    ]
  }
}
