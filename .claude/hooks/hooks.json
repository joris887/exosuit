{
  "$schema": "https://json.schemastore.org/claude-code-hooks.json",
  "_comment": "Declarative hook definitions for plugin distribution. Uses ${CLAUDE_PLUGIN_ROOT} for portable paths (scripts live in the plugin cache) and cd's to the project root so hooks operate on project state. Drop-in installs use .claude/settings.json instead.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel 2>/dev/null || echo .)\" && sh \"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/session-start.sh\"",
            "once": true,
            "statusMessage": "Checking project environment..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel 2>/dev/null || echo .)\" && sh \"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/pre-tool-use.sh\"",
            "statusMessage": "Safety check..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel 2>/dev/null || echo .)\" && sh \"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/worktree-bash-fix.sh\""
          }
        ],
        "apply_to_subagents": true
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel 2>/dev/null || echo .)\" && sh \"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/pre-read-check.sh\"",
            "statusMessage": "Checking file sensitivity..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel 2>/dev/null || echo .)\" && sh \"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/post-tool-use.sh\"",
            "statusMessage": "Logging activity..."
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel 2>/dev/null || echo .)\" && bash \"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/post-edit-format.sh\" \"$FILE_PATH\"",
            "statusMessage": "Auto-formatting..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel 2>/dev/null || echo .)\" && sh \"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/stop.sh\"",
            "statusMessage": "Quality gate..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel 2>/dev/null || echo .)\" && sh \"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/user-prompt.sh\"",
            "statusMessage": "Analyzing request..."
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel 2>/dev/null || echo .)\" && sh \"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/worktree.sh\" WorktreeCreate",
            "statusMessage": "Setting up worktree..."
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel 2>/dev/null || echo .)\" && sh \"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/worktree.sh\" WorktreeRemove",
            "statusMessage": "Cleaning up worktree..."
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel 2>/dev/null || echo .)\" && sh \"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/subagent-stop.sh\""
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel 2>/dev/null || echo .)\" && sh \"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/pre-compact.sh\"",
            "statusMessage": "Preserving session state..."
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel 2>/dev/null || echo .)\" && sh \"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/post-tool-failure.sh\"",
            "statusMessage": "Analyzing failure..."
          }
        ]
      }
    ]
  }
}
